# テンプレートです。実際の登録は ./install-desktop-shortcut.sh が絶対パスで生成します。
# アイコンは画面を開くだけ (open-ui.sh)。サーバーは ./install-service.sh でサービス化してください。
[Desktop Entry]
Version=1.0
Type=Application
Name=Linux Auto
GenericName=Android Auto Headunit Support
Comment=Google DHU を使用した Android Auto 接続 GUI ツール
Exec=./open-ui.sh
Terminal=false
Categories=Utility;AudioVideo;
StartupNotify=true
