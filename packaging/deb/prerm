#!/bin/sh
# Linux Auto - アンインストール前の処理 (prerm)
#   削除時のみ: ログイン中ユーザーのサーバーを停止し、自動起動の設定を外す
#   (更新時は何もしない。postinst で新しいバージョンに再起動する)
set -e

SERVICE=linux-auto.service

for_each_logged_in_user() {
    command -v loginctl >/dev/null 2>&1 || return 0
    loginctl list-users --no-legend 2>/dev/null | while read -r uid user _rest; do
        [ -n "$user" ] || continue
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        systemctl --user -M "$user@" "$@" >/dev/null 2>&1 || true
    done
}

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            for_each_logged_in_user stop "$SERVICE"
            systemctl --global disable "$SERVICE" >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
